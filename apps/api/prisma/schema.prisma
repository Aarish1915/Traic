generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id         String   @id @default(uuid()) @db.VarChar(120)
  data       Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([updated_at(sort: Desc)], map: "idx_settings_updated_at")
  @@map("settings")
}

model Member {
  id         String   @id @default(uuid()) @db.VarChar(120)
  data       Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([updated_at(sort: Desc)], map: "idx_members_updated_at")
  @@map("members")
}

