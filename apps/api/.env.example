# ==============================================================================
# TRAIC API Environment Configuration (.env)
# ==============================================================================

# Server Port
PORT=4000
NODE_ENV=development

# Admin Master Password (Timing-safe comparison)
ADMIN_PASSWORD=traic_admin_2025!

# Secret key for session signature (Minimum 16 characters)
SESSION_SECRET=development_secret_must_change_in_production_traic

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# Remote PostgreSQL Database Connection String (e.g. Neon, Render, Supabase)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[database]?sslmode=require
# If omitted or commented out, the API automatically runs with local Atomic Disk Persistence (data/traic_store.json).
# DATABASE_URL=postgresql://neondb_owner:npg_samplepassword123@ep-sample-pooler-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
