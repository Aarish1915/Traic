{
  "name": "traic-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @traic/web dev",
    "dev:admin": "pnpm --filter @traic/admin dev",
    "dev:api": "pnpm --filter @traic/api dev"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "prettier": "^3.5.3"
  },
  "packageManager": "pnpm@12.6.0"
}
