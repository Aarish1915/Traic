{
  "name": "traic-monorepo",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "npx tsx --test tests/contracts.test.mjs",
    "test:integration": "node tests/test_full_suite.mjs",
    "test:all": "pnpm test && pnpm test:integration",
    "dev:web": "pnpm --filter @traic/web dev",
    "dev:admin": "pnpm --filter @traic/admin dev",
    "dev:api": "pnpm --filter @traic/api dev",
    "build:api": "pnpm --filter @traic/api build",
    "start:api": "node apps/api/dist/server.js"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "prettier": "^3.5.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@9.15.4"
}
